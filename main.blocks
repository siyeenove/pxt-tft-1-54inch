<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id="=},m)l%qnipVb[23Va_|" x="0" y="0"><statement name="HANDLER"><block type="typescript_statement" id="P1CIa0T{(8z/KsjPoY~i"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="enum Color {" line1="    //% block=&quot;Black&quot;" line2="    Black = 0x0000," line3="    //% block=&quot;Navy&quot;" line4="    Navy = 0x000F," line5="    //% block=&quot;DarkGreen&quot;" line6="    DarkGreen = 0x03E0," line7="    //% block=&quot;DarkCyan&quot;" line8="    DarkCyan = 0x03EF," line9="    //% block=&quot;Maroon&quot;" line10="    Maroon = 0x7800," line11="    //% block=&quot;Purple&quot;" line12="    Purple = 0x780F," line13="    //% block=&quot;Olive&quot;" line14="    Olive = 0x7BE0," line15="    //% block=&quot;LightGrey&quot;" line16="    LightGrey = 0xC618," line17="    //% block=&quot;DarkGrey&quot;" line18="    DarkGrey = 0x7BEF," line19="    //% block=&quot;Blue&quot;" line20="    Blue = 0x001F," line21="    //% block=&quot;Green&quot;" line22="    Green = 0x07E0," line23="    //% block=&quot;Cyan&quot;" line24="    Cyan = 0x07FF," line25="    //% block=&quot;Red&quot;" line26="    Red = 0xF800," line27="    //% block=&quot;Magenta&quot;" line28="    Magenta = 0xF81F," line29="    //% block=&quot;Yellow&quot;" line30="    Yellow = 0xFFE0," line31="    //% block=&quot;White&quot;" line32="    White = 0xFFFF," line33="    //% block=&quot;Orange&quot;" line34="    Orange = 0xFD20," line35="    //% block=&quot;GreenYellow&quot;" line36="    GreenYellow = 0xAFE5," line37="    //% block=&quot;Pink&quot;" line38="    Pink = 0xF81F" line39="}" numlines="40"></mutation><next><block type="typescript_statement" id="taS]DOUTWzSwBZwGUQtM"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace RBTFT18 {" line1="    // Display commands &amp; constants" line2="    let TFTWIDTH = 130" line3="    let TFTHEIGHT = 162" line4="" line5="    /**" line6="     * TFT Commands" line7="     */" line8="    enum TFTCommands {" line9="        NOP = 0x00," line10="        SWRESET = 0x01," line11="        SLPOUT = 0x11," line12="        NORON = 0x13," line13="        INVOFF = 0x20," line14="        DISPOFF = 0x28," line15="        DISPON = 0x29," line16="        CASET = 0x2A," line17="        RASET = 0x2B," line18="        RAMWR = 0x2C," line19="        MADCTL = 0x36," line20="        COLMOD = 0x3A," line21="        FRMCTR1 = 0xB1," line22="        FRMCTR2 = 0xB2," line23="        FRMCTR3 = 0xB3," line24="        INVCTR = 0xB4," line25="        PWCTR1 = 0xC0," line26="        PWCTR2 = 0xC1," line27="        PWCTR3 = 0xC2," line28="        PWCTR4 = 0xC3," line29="        PWCTR5 = 0xC4," line30="        VMCTR1 = 0xC5," line31="        GMCTRP1 = 0xE0," line32="        GMCTRN1 = 0xE1," line33="        DELAY = 0xFFFF" line34="    }" line35="" line36="    /**" line37="     * Unicode representation" line38="     * The unicode table is split into seven parts because of memory size and array size limitations of the microbit" line39="     */" line40="    let fontOne: number[] = [0x0022d422, 0x0022d422, 0x0022d422, 0x0022d422, 0x0022d422, 0x0022d422," line41="        0x0022d422, 0x0022d422, 0x0022d422, 0x0022d422, 0x0022d422, 0x0022d422, 0x0022d422, 0x0022d422," line42="        0x0022d422, 0x0022d422, 0x0022d422, 0x0022d422, 0x0022d422, 0x0022d422]" line43="    let fontTwo: number[] = [0x0022d422, 0x0022d422, 0x0022d422, 0x0022d422, 0x0022d422, 0x0022d422," line44="        0x0022d422, 0x0022d422, 0x0022d422, 0x0022d422, 0x0022d422, 0x0022d422, 0x00000000, 0x000002e0," line45="        0x00018060, 0x00afabea, 0x00aed6ea, 0x01991133, 0x010556aa, 0x00000060]" line46="    let fontThree: number[] = [0x000045c0, 0x00003a20, 0x00051140, 0x00023880, 0x00002200, 0x00021080," line47="        0x00000100, 0x00111110, 0x0007462e, 0x00087e40, 0x000956b9, 0x0005d629, 0x008fa54c, 0x009ad6b7," line48="        0x008ada88, 0x00119531, 0x00aad6aa, 0x0022b6a2, 0x00000140, 0x00002a00]" line49="    let fontFour: number[] = [0x0008a880, 0x00052940, 0x00022a20, 0x0022d422, 0x00e4d62e, 0x000f14be," line50="        0x000556bf, 0x0008c62e, 0x0007463f, 0x0008d6bf, 0x000094bf, 0x00cac62e, 0x000f909f, 0x000047f1," line51="        0x0017c629, 0x0008a89f, 0x0008421f, 0x01f1105f, 0x01f4105f, 0x0007462e]" line52="    let fontFive: number[] = [0x000114bf, 0x000b6526, 0x010514bf, 0x0004d6b2, 0x0010fc21, 0x0007c20f," line53="        0x00744107, 0x01f4111f, 0x000d909b, 0x00117041, 0x0008ceb9, 0x0008c7e0, 0x01041041, 0x000fc620," line54="        0x00010440, 0x01084210, 0x00000820, 0x010f4a4c, 0x0004529f, 0x00094a4c]" line55="    let fontSix: number[] = [0x000fd288, 0x000956ae, 0x000097c4, 0x0007d6a2, 0x000c109f, 0x000003a0," line56="        0x0006c200, 0x0008289f, 0x000841e0, 0x01e1105e, 0x000e085e, 0x00064a4c, 0x0002295e, 0x000f2944," line57="        0x0001085c, 0x00012a90, 0x010a51e0, 0x010f420e, 0x00644106, 0x01e8221e]" line58="    let fontSeven: number[] = [0x00093192, 0x00222292, 0x00095b52, 0x0008fc80, 0x000003e0, 0x000013f1," line59="        0x00841080, 0x0022d422];" line60="" line61="" line62="    /*" line63="     * Send command to display" line64="     */" line65="    function send(command: TFTCommands, parameter: Array&lt;number&gt;): void {" line66="        // set TFT to command-receive mode" line67="        pins.digitalWritePin(DigitalPin.P1, 0)" line68="        // select TFT controller" line69="        pins.digitalWritePin(DigitalPin.P16, 0)" line70="        // Send command" line71="        pins.spiWrite(command)" line72="" line73="        // set TFT back to data-receive mode" line74="        pins.digitalWritePin(DigitalPin.P1, 1)" line75="" line76="        for (let item of parameter) {" line77="            pins.spiWrite(item)" line78="        }" line79="" line80="        // deselect TFT controller" line81="        pins.digitalWritePin(DigitalPin.P16, 1)" line82="    }" line83="" line84="    /*" line85="     * Set pixel address window - minimum and maximum pixel bounds" line86="     */" line87="    function setWindow(x0: number, y0: number, x1: number, y1: number): void {" line88="        send(TFTCommands.CASET, [0x00, x0, 0x00, x1])" line89="        send(TFTCommands.RASET, [0x00, y0, 0x00, y1])" line90="    }" line91="" line92="    /*" line93="     * Data-Mode to transfer data to TFT for further processing" line94="     */" line95="    function enterDataMode(): void {" line96="        // Activate command mode" line97="        pins.digitalWritePin(DigitalPin.P1, 0)" line98="        // select TFT as SPI-target" line99="        pins.digitalWritePin(DigitalPin.P16, 0)" line100="        pins.spiWrite(TFTCommands.RAMWR)" line101="        // Activate data mode" line102="        pins.digitalWritePin(DigitalPin.P1, 1)" line103="    }" line104="" line105="    /*" line106="     * Finish data-mode and set back to command-mode" line107="     */" line108="    function exitDataMode(): void {" line109="        pins.digitalWritePin(DigitalPin.P16, 1) // de-elect the TFT as SPI target" line110="        pins.digitalWritePin(DigitalPin.P1, 0) // command/data = command" line111="    }" line112="" line113="    /*" line114="     * Initial TFT setup" line115="     */" line116="    //% block=&quot;Initialize TFT Display&quot;" line117="    //% weight=100" line118="    export function init(): void {" line119="        // set SPI frequency" line120="        pins.spiFrequency(4000000)" line121="" line122="        // Software reset" line123="        send(TFTCommands.SWRESET, [1])" line124="        // Exit Sleep mode" line125="        send(TFTCommands.SLPOUT, [1])" line126="        // Frame rate control - normal mode" line127="        send(TFTCommands.FRMCTR1, [0x01, 0x2C, 0x2D])" line128="        // Frame rate control - idle mode" line129="        send(TFTCommands.FRMCTR2, [0x01, 0x2C, 0x2D, 0x01, 0x2C, 0x2D])" line130="        // Display inversion control" line131="        send(TFTCommands.INVCTR, [0x07])" line132="        // Display power control" line133="        send(TFTCommands.PWCTR1, [0xA2, 0x02, 0x84])" line134="        send(TFTCommands.PWCTR2, [0x8A, 0x2A])" line135="        send(TFTCommands.PWCTR3, [0x0A, 0x00])" line136="        send(TFTCommands.PWCTR4, [0x8A, 0x2A])" line137="        send(TFTCommands.PWCTR5, [0x8A, 0xEE])" line138="        send(TFTCommands.VMCTR1, [0x0E])" line139="" line140="        // Disable inversion" line141="        send(TFTCommands.INVOFF, [])" line142="" line143="        // Memory access control" line144="        send(TFTCommands.MADCTL, [0xC8])" line145="" line146="        // Set 16-bit color mode" line147="        send(TFTCommands.COLMOD, [0x05])" line148="" line149="        // Column address set" line150="        send(TFTCommands.CASET, [0x00, 0x00, 0x00, 0x7F])" line151="        // Row address set" line152="        send(TFTCommands.RASET, [0x00, 0x00, 0x00, 0x9F])" line153="" line154="        // Set Gamma" line155="        send(TFTCommands.GMCTRP1, [0x02, 0x1C, 0x07, 0x12, 0x37, 0x32, 0x29, 0x2D, 0x29, 0x25, 0x2B, 0x39, 0x00, 0x01, 0x03, 0x10])" line156="        send(TFTCommands.GMCTRN1, [0x03, 0x1D, 0x07, 0x06, 0x2E, 0x2C, 0x29, 0x2D, 0x2E, 0x2E, 0x37, 0x3F, 0x00, 0x00, 0x02, 0x10])" line157="" line158="        // Set normal mode" line159="        send(TFTCommands.NORON, [])" line160="" line161="        // Turn display on" line162="        send(TFTCommands.DISPON, [])" line163="    }" line164="" line165="    /*" line166="     * Draw single pixel" line167="     */" line168="    //% block=&quot;Draw single pixel at x:%x|y:%y with color:%color&quot;" line169="    //% x.min=1 x.max=130" line170="    //% y.min=1 y.max=162" line171="    //% weight=90" line172="    export function drawPixel(x: number, y: number, color: Color): void {" line173="        setWindow(x, y, x + 1, y + 1)" line174="        send(TFTCommands.RAMWR, [color &gt;&gt; 8, color])" line175="    }" line176="" line177="    /*" line178="     * Draw a straight line from one point to another" line179="     */" line180="    //% block=&quot;Draw line from x0:%x0|y0:%y0 to x1:%x1|y:%y1 with color:%color&quot;" line181="    //% x0.min=1 x0.max=130" line182="    //% y0.min=1 y0.max=162" line183="    //% x1.min=1 x1.max=130" line184="    //% y1.min=1 y1.max=162" line185="    //% weight=85" line186="    export function drawLine(x0: number, y0: number, x1: number, y1: number, color: Color): void {" line187="        let xDelta = x1 - x0" line188="        let yDelta = y1 - y0" line189="" line190="        if (Math.abs(yDelta) &gt; Math.abs(xDelta)) {" line191="            let ySteps = Math.abs(yDelta)" line192="            let xIncrement = xDelta == 0 ? 0 : xDelta / ySteps" line193="            let yIncrement = yDelta &gt; 0 ? 1 : -1" line194="" line195="            let x = x0" line196="            let y = y0" line197="            for (let steps = 0; steps &lt;= ySteps; steps++) {" line198="                drawPixel(x, y, color)" line199="            }" line200="        }" line201="        else {" line202="            let xSteps = Math.abs(xDelta)" line203="            let yIncrement2 = yDelta == 0 ? 0 : yDelta / xSteps" line204="            let xIncrement2 = xDelta &gt; 0 ? 1 : -1" line205="" line206="            let y2 = y0" line207="            let x2 = x0" line208="            for (let steps2 = 0; steps2 &lt;= xSteps; steps2++) {" line209="                drawPixel(x2, y2, color)" line210="                y2 = y2 + yIncrement2" line211="                x2 = x2 + xIncrement2" line212="            }" line213="        }" line214="    }" line215="" line216="    /*" line217="     * Draw rectangle with a given color" line218="     */" line219="    //% block=&quot;Draw rectangle at x:%x|y:%y with width:%width|height:%height|color:%color&quot;" line220="    //% x.min=1 x.max=130" line221="    //% y.min=1 y.max=162" line222="    //% weight=80" line223="    export function drawRectangle(x: number, y: number, width: number, height: number, color: Color): void {" line224="" line225="        // Convert color" line226="        let hiColor = (color &gt;&gt; 8) % 256" line227="        let loColor = color % 256" line228="" line229="        setWindow(x, y, x + width - 1, y + height - 1)" line230="        enterDataMode()" line231="" line232="        // Draw rectangle" line233="        for (let indexY = height; indexY &gt; 0; indexY--) {" line234="            for (let indexX = width; indexX &gt; 0; indexX--) {" line235="                pins.spiWrite(hiColor);" line236="                pins.spiWrite(loColor);" line237="            }" line238="        }" line239="" line240="        exitDataMode()" line241="    }" line242="" line243="    /*" line244="     * Draw circle with a given radius" line245="     */" line246="    //% block=&quot;Draw circle at: x:%x|y:%y with radius:%r and color:%color&quot;" line247="    //% x.min=1 x.max=130" line248="    //% y.min=1 y.max=162" line249="    //% weight=75" line250="    export function drawCircle(x: number, y: number, radius: number, color: Color): void {" line251="        for (let y1 = -radius; y1 &lt;= 0; y1++) {" line252="            for (let x1 = -radius; x1 &lt;= 0; x1++) {" line253="                if ((x1 * x1 + y1 * y1) &lt;= (radius * radius)) {" line254="                    drawPixel(x + x1, y + y1, color)" line255="                    drawPixel(x + x1, y - y1, color)" line256="                    drawPixel(x - x1, y + y1, color)" line257="                    drawPixel(x - x1, y - y1, color)" line258="                }" line259="            }" line260="        }" line261="    }" line262="" line263="    /*" line264="     * Display string at given coordinates" line265="     */" line266="    //% block=&quot;Show string:%string at x:%x and y:%y with zoom-level:%zoom color:%color and background color:%bgcolor&quot;" line267="    //% weight=70" line268="    //% x.min=1 x.max=130" line269="    //% y.min=1 y.max=162" line270="    //% zoom.min=1 zoom.max=5" line271="    export function showString(text: string, x: number, y: number, zoom: number, color: Color, bgColor: Color): void {" line272="        let hiColor2 = (color &gt;&gt; 8) % 256" line273="        let loColor2 = color % 256" line274="        let bgHiColor = (bgColor &gt;&gt; 8) % 256" line275="        let bgLoColor = bgColor % 256" line276="        let zoomFactor = zoom" line277="        let index = 0" line278="        let colsel = 0" line279="        let unicode = 0" line280="        let charIndex = 0" line281="" line282="        for (let stringPos = 0; stringPos &lt; text.length; stringPos++) {" line283="            // Get character at current string position and find the corresponding unicode representation" line284="            charIndex = text.charCodeAt(stringPos)" line285="            if (charIndex &lt; 20) {" line286="                unicode = fontOne[charIndex]" line287="            }" line288="            else if (charIndex &lt; 40) {" line289="                unicode = fontTwo[charIndex - 20]" line290="            }" line291="            else if (charIndex &lt; 60) {" line292="                unicode = fontThree[charIndex - 40]" line293="            }" line294="            else if (charIndex &lt; 80) {" line295="                unicode = fontFour[charIndex - 60]" line296="            }" line297="            else if (charIndex &lt; 100) {" line298="                unicode = fontFive[charIndex - 80]" line299="            }" line300="            else if (charIndex &lt; 120) {" line301="                unicode = fontSix[charIndex - 100]" line302="            }" line303="            else if (charIndex &lt; 140) {" line304="                unicode = fontSeven[charIndex - 120]" line305="            }" line306="" line307="            // Set position and go into data mode" line308="            setWindow(x + stringPos * 5 * zoomFactor, y, x + stringPos * 5 * zoomFactor + 5 * zoomFactor - 1, y + 5 * zoomFactor - 1)" line309="            enterDataMode()" line310="" line311="            // write character to display" line312="            for (let indexY2 = 0; indexY2 &lt; 5; indexY2++) {" line313="                for (let a = 0; a &lt; zoomFactor; a++) {" line314="                    for (let indexX2 = 0; indexX2 &lt; 5; indexX2++) {" line315="                        index = indexY2 + indexX2 * 5" line316="                        colsel = (unicode &amp; (1 &lt;&lt; index))" line317="                        for (let b = 0; b &lt; zoomFactor; b++) {" line318="                            if (colsel) {" line319="                                pins.spiWrite(hiColor2);" line320="                                pins.spiWrite(loColor2);" line321="                            }" line322="                            else {" line323="                                pins.spiWrite(bgHiColor);" line324="                                pins.spiWrite(bgLoColor);" line325="                            }" line326="                        }" line327="                    }" line328="                }" line329="            }" line330="" line331="            exitDataMode();" line332="        }" line333="    }" line334="" line335="    //% block=&quot;Clear screen&quot;" line336="    //% weight=65" line337="    export function clearScreen(): void {" line338="        drawRectangle(0, 0, TFTWIDTH, TFTHEIGHT, 0)" line339="    }" line340="" line341="    //% block=&quot;Turn display off&quot;" line342="    //% weight=60" line343="    export function turnOff(): void {" line344="        send(TFTCommands.DISPOFF, [])" line345="    }" line346="" line347="    //% block=&quot;Turn display on&quot;" line348="    //% weight=55" line349="    export function turnOn(): void {" line350="        send(TFTCommands.DISPON, [])" line351="    }" line352="" line353="" line354="}" numlines="355"></mutation></block></next></block></statement></block></xml>